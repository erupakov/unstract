# =============================================================================
# Production backend overrides  (EXTERNAL Postgres 17 / Redis / S3)
# =============================================================================
# Layered ON TOP of backend/.env at compose time, so it only carries the deltas
# for an external-infra, single-host production run. Merge order in
# docker-compose.prod.yaml is: backend/.env  then  docker/prod.essentials.env
# then this file (later wins), so anything set here overrides the others.
#
# Copy and fill:   cp sample.prod.backend.env prod.backend.env
# (or just rely on docker/prod.essentials.env, which already points DB/Redis/S3
#  at the externals — this file is for backend-only production hardening.)
# =============================================================================

# Serve without Django's debug toolbar / verbose tracebacks.
DJANGO_SETTINGS_MODULE=backend.settings.dev
DEFAULT_LOG_LEVEL=INFO

# Public origin the browser uses. MUST equal the host Traefik routes on, or CORS,
# CSRF and the Socket.IO handshake break. Keep in sync with UNSTRACT_HOST.
WEB_APP_ORIGIN_URL=http://unstract.example.com
DJANGO_APP_BACKEND_URL=http://unstract.example.com

# Cookies: set True when serving over HTTPS (behind your TLS terminator).
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Postgres 17 (external). Keep aligned with docker/prod.essentials.env.
DB_HOST=db.example.com
DB_PORT=5432
DB_USER=unstract
DB_PASSWORD=change-me-strong-password
DB_NAME=unstract_db
DB_SCHEMA=unstract

# Redis (external). Keep aligned with docker/prod.essentials.env.
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=default

# Rotate the dev placeholders before exposing the platform.
#   DJANGO_SECRET_KEY:  python -c 'import secrets; print(secrets.token_urlsafe(50))'
#   ENCRYPTION_KEY    :  python -c 'import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
#   INTERNAL_SERVICE_API_KEY: shared with workers/.env — rotate in both.
# DJANGO_SECRET_KEY=
# ENCRYPTION_KEY=
# INTERNAL_SERVICE_API_KEY=

# Object storage (external S3). docker-compose.prod.yaml derives these JSON blobs
# from the UNSTRACT_S3_* values in docker/prod.essentials.env, so you normally do
# NOT set them here. Shown for reference / manual override:
# WORKFLOW_EXECUTION_FILE_STORAGE_CREDENTIALS='{"provider": "s3", "credentials": {"key": "...", "secret": "...", "client_kwargs": {"region_name": "..."}}}'
# API_FILE_STORAGE_CREDENTIALS='{"provider": "s3", "credentials": {"key": "...", "secret": "...", "client_kwargs": {"region_name": "..."}}}'
# PERMANENT_REMOTE_STORAGE='{"provider": "s3", "credentials": {"key": "...", "secret": "...", "client_kwargs": {"region_name": "..."}}}'
# TEMPORARY_REMOTE_STORAGE='{"provider": "s3", "credentials": {"key": "...", "secret": "...", "client_kwargs": {"region_name": "..."}}}'
# HITL_FILES_FILE_STORAGE_CREDENTIALS='{"provider": "s3", "credentials": {"key": "...", "secret": "...", "client_kwargs": {"region_name": "..."}}}'
