# =============================================================================
# Production runner overrides  (EXTERNAL Redis / RabbitMQ in-stack / S3)
# =============================================================================
# Layered ON TOP of runner/.env at compose time. Merge order in
# docker-compose.prod.yaml: runner/.env  then  docker/prod.essentials.env
# then this file (later wins).
#
# Copy and fill:   cp sample.prod.runner.env prod.runner.env
#
# The runner spawns tool containers on the host Docker socket and forwards its
# Redis / storage / broker settings to every tool sidecar it starts, so keep
# these aligned with the backend and workers.
# =============================================================================

LOG_LEVEL=INFO

# RabbitMQ (Celery broker) — the broker container runs in this stack.
CELERY_BROKER_BASE_URL=amqp://unstract-rabbitmq:5672//
CELERY_BROKER_USER=admin
CELERY_BROKER_PASS=change-me-strong-password

# Redis (external). Forwarded to tool sidecars for logs + execution cache.
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=

# Object storage (external S3) for workflow execution files.
# docker-compose.prod.yaml derives this from UNSTRACT_S3_* in
# docker/prod.essentials.env; shown here for reference / manual override.
# WORKFLOW_EXECUTION_FILE_STORAGE_CREDENTIALS='{"provider": "s3", "credentials": {"key": "...", "secret": "...", "client_kwargs": {"region_name": "..."}}}'

# Tool containers attach to this compose network; leave as-is for a single host.
TOOL_CONTAINER_NETWORK="unstract-network"
