# =============================================================================
# Production workers overrides  (EXTERNAL Postgres 17 / Redis / S3)
# =============================================================================
# Layered ON TOP of workers/.env at compose time for EVERY worker-pg-* service.
# Merge order in docker-compose.prod.yaml:
#   workers/.env  ->  docker/prod.essentials.env  ->  this file  ->  inline env
# (later wins). Because this file is loaded AFTER the per-service inline
# `ENVIRONMENT=development`, setting ENVIRONMENT here switches the whole PG-era
# worker fleet to production.
#
# Copy and fill:   cp sample.prod.workers.env prod.workers.env
# =============================================================================

# Runs the worker fleet in production mode (overrides the inline
# ENVIRONMENT=development baked into docker-compose.yaml).
ENVIRONMENT=production

# Backend internal API (workers -> backend). Container-to-container over the
# compose network; the backend service name is stable, so this stays as-is.
DJANGO_APP_BACKEND_URL=http://unstract-backend:8000
INTERNAL_API_BASE_URL=http://unstract-backend:8000/internal

# Must MATCH backend/.env INTERNAL_SERVICE_API_KEY (rotate both together).
INTERNAL_SERVICE_API_KEY=dev-internal-key-123

# RabbitMQ (Celery broker) — broker container runs in this stack.
CELERY_BROKER_BASE_URL=amqp://unstract-rabbitmq:5672//
CELERY_BROKER_USER=admin
CELERY_BROKER_PASS=change-me-strong-password

# Postgres 17 (external) — Celery result backend + PG-queue transport.
DB_HOST=db.example.com
DB_PORT=5432
DB_USER=unstract
DB_PASSWORD=change-me-strong-password
DB_NAME=unstract_db
DB_SCHEMA=unstract
DATABASE_URL=postgresql://unstract:change-me-strong-password@db.example.com:5432/unstract_db

# Redis (external). Keep the *_REDIS_DB values aligned with backend/.env:
# CACHE_REDIS_DB here MUST equal FILE_ACTIVE_CACHE_REDIS_DB in backend/.env or
# active-file dedup silently misses.
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=default
REDIS_DB=0

CACHE_REDIS_ENABLED=true
CACHE_REDIS_HOST=redis.example.com
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
CACHE_REDIS_PASSWORD=
CACHE_REDIS_USERNAME=
