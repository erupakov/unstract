# =============================================================================
# Production x2text-service overrides  (EXTERNAL Postgres 17)
# =============================================================================
# Layered ON TOP of x2text-service/.env at compose time. Merge order in
# docker-compose.prod.yaml: x2text-service/.env  then  docker/prod.essentials.env
# then this file (later wins).
#
# Copy and fill:   cp sample.prod.x2text.env prod.x2text.env
# =============================================================================

DB_HOST=db.example.com
DB_PORT=5432
DB_USERNAME=unstract
DB_PASSWORD=change-me-strong-password
DB_NAME=unstract_db
DB_SCHEMA=unstract
