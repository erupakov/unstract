# =============================================================================
# Production platform-service overrides  (EXTERNAL Postgres 17 / Redis / S3)
# =============================================================================
# Layered ON TOP of platform-service/.env at compose time. Merge order in
# docker-compose.prod.yaml: platform-service/.env  then  docker/prod.essentials.env
# then this file (later wins).
#
# Copy and fill:   cp sample.prod.platform-service.env prod.platform-service.env
# =============================================================================

LOG_LEVEL=INFO

# Redis (external). platform-service uses REDIS_USERNAME (not REDIS_USER).
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# Backend Postgres 17 (external).
PG_BE_HOST=db.example.com
PG_BE_PORT=5432
PG_BE_USERNAME=unstract
PG_BE_PASSWORD=change-me-strong-password
PG_BE_DATABASE=unstract_db
DB_SCHEMA=unstract

# ENCRYPTION_KEY must MATCH backend/.env exactly — adapter credentials are
# encrypted with it, and a mismatch makes stored credentials unreadable.
# ENCRYPTION_KEY=

# Model-price cache. With external S3, point this at a bucket path and set
# FILE_STORAGE_CREDENTIALS to the same S3 blob the backend uses; otherwise the
# service keeps its local default and refetches prices from the network.
# REMOTE_MODEL_PRICES_FILE_PATH=unstract/cost/model_prices.json
# FILE_STORAGE_CREDENTIALS='{"provider": "s3", "credentials": {"key": "...", "secret": "...", "client_kwargs": {"region_name": "..."}}}'
