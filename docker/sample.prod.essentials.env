# =============================================================================
# Production essentials overrides (EXTERNAL Postgres 17 / Redis / S3)
# =============================================================================
# Values here are read by docker-compose.prod.yaml (and, for the values that the
# infra containers also read, by the app services via `env_file`). They are
# MERGED ON TOP OF the per-service `.env` files produced from the dev samples,
# so this file only needs to carry the deltas for an external-infra deployment.
#
# Copy to `prod.essentials.env` (git-ignored) and fill in real endpoints/secrets:
#   cp sample.prod.essentials.env prod.essentials.env
#
# In this topology Postgres, Redis and S3 are EXTERNAL services. The only
# infra-ish containers this stack still starts are the reverse proxy (Traefik),
# Flipt (feature flags) and Qdrant (vector DB for the doc indexer) — see
# docker-compose.prod.yaml.
# =============================================================================

# --- Public host -------------------------------------------------------------
# Single source of truth for the host the platform is served on. docker-compose.prod.yaml
# rewrites the Traefik router rules and the frontend/backend origins from this value.
#   Unsecured:      UNSTRACT_HOST=unstract.example.com
#   Behind TLS:     set UNSTRACT_SCHEME=https (see below) and terminate TLS at your
#                   own load balancer / reverse proxy in front of Traefik :80.
UNSTRACT_HOST=unstract.example.com
UNSTRACT_SCHEME=http

# --- External PostgreSQL 17 --------------------------------------------------
# Must be PostgreSQL 17 WITH pgvector installed (the doc indexer stores vectors).
# The connecting role must own (or be able to CREATE) the application schema and
# have CREATEDB, because `manage.py migrate` and the backend DB-setup expectations
# create the schema and the `unstract_celery`-style helper databases. See
# docker/README-production.md "External PostgreSQL" for the one-time SQL.
POSTGRES_HOST=db.example.com
POSTGRES_PORT=5432
POSTGRES_USER=unstract
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=unstract_db
POSTGRES_SCHEMA=unstract

# --- External Redis ----------------------------------------------------------
# Plaintext example below. For a managed/TLS endpoint, prefer setting REDIS_URL
# (scheme `rediss://` carries TLS) plus REDIS_PASSWORD, and leave the discrete
# REDIS_SSL* keys commented — see backend/sample.env for the full precedence.
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=
# Leave empty for a managed endpoint that authenticates as the built-in `default`
# user. Named ACL users are not supported platform-wide.
REDIS_USER=default
# --- TLS to managed Redis (optional) — uncomment as needed -------------------
# REDIS_SSL=true
# REDIS_SSL_CERT_REQS=required
# REDIS_SSL_CA_CERTS=            # only when the CA is not publicly trusted
# REDIS_SSL_CHECK_HOSTNAME=false # for endpoints addressed by IP/internal CNAME
# REDIS_URL=rediss://redis.example.com:6380/0?ssl_cert_reqs=required

# --- External S3 (object storage) -------------------------------------------
# Consumed by docker-compose.prod.yaml, which interpolates these into the JSON
# storage-credential blobs (WORKFLOW_EXECUTION_FILE_STORAGE_CREDENTIALS, etc.).
#   AWS S3:            UNSTRACT_S3_ENDPOINT_URL=        (blank)
#   S3-compatible:     UNSTRACT_S3_ENDPOINT_URL=https://s3.example.com
# Set UNSTRACT_S3_REGION to the bucket region; leave blank to let boto3 resolve
# it from the environment/instance profile.
UNSTRACT_S3_BUCKET=unstract-prod
UNSTRACT_S3_KEY=AKIAxxxxxxxxxxxxxxxx
UNSTRACT_S3_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UNSTRACT_S3_ENDPOINT_URL=
UNSTRACT_S3_REGION=

# --- Feature flags (Flipt) ---------------------------------------------------
# Flipt runs as a container in this stack; keep the dev defaults unless you
# bring your own Flipt.
EVALUATION_SERVER_IP=unstract-flipt
EVALUATION_SERVER_PORT=9000

# --- RabbitMQ (Celery broker) ------------------------------------------------
# RabbitMQ stays IN the stack (docker-compose.prod.yaml) for tool-execution RPC.
# These are the credentials the broker container and the publishers agree on.
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me-strong-password
# AMQP URL the app/worker services dial. Host = the rabbitmq container name.
CELERY_BROKER_BASE_URL=amqp://unstract-rabbitmq:5672//
CELERY_BROKER_USER=admin
CELERY_BROKER_PASS=change-me-strong-password

# --- Qdrant (vector DB, runs in the stack) -----------------------------------
# Only needed if you bring your own Qdrant; otherwise the container self-hosts.
# QDRANT_HOST=unstract-vector-db
# QDRANT_PORT=6333
